[Unit]
Description=tpt-telemetry unified syslog -> OTLP daemon
Documentation=https://github.com/tpt-solutions/tpt-telemetry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tpt-daemon --config /etc/tpt-daemon/tpt-daemon.toml
Restart=on-failure
RestartSec=2

# Run as a transient, non-root dynamic user.
DynamicUser=true
User=tpt-daemon
Group=tpt-daemon

# Hardening: full system call / filesystem lockdown.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# Deny memory that is both writable and executable. The daemon is pure Rust
# (tokio/tonic/ureq) with no JIT or runtime code-generation, so no mapping ever
# needs W^X — keeping this enabled is strictly safer than the previous `false`.
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Allow binding to privileged syslog ports (514) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Persist the config + metrics state outside the read-only root.
ConfigurationDirectory=tpt-daemon
StateDirectory=tpt-daemon
RuntimeDirectory=tpt-daemon

# Logs go to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tpt-daemon

[Install]
WantedBy=multi-user.target
